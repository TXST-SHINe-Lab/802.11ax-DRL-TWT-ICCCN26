# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
ENV/
env/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Data artifacts - exclude runtime data logs
data-log/

# Exploration/EDA - exclude logs and transitions (keep summary data)
exploration-scripts/eda-data/*/logs/
exploration-scripts/eda-data/*/transitions/

# Trained model binaries: KEEP the final model of each run (*_final.zip)
# and the step checkpoints (*_steps.zip, e.g. the 10000-step one),
# plus the VecNormalize stats needed to load them.
# Ignore any other .pkl artifacts.
ppo-sb3-scripts/checkpoints/**/*.zip
ppo-sb3-scripts/checkpoints/**/*.pkl
!ppo-sb3-scripts/checkpoints/**/*_final.zip
!ppo-sb3-scripts/checkpoints/**/*_steps.zip
!ppo-sb3-scripts/checkpoints/**/vecnormalize.pkl

# TensorBoard event files (regenerated by training)
ppo-sb3-scripts/tb_logs/

# PCAP captures
*.pcap
*.pcapng

# Build artifacts
CMakeFiles/
cmake_install.cmake
Makefile
*.o
*.a

# Temporary files
/tmp/
*.log
.#*
